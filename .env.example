# Haqdaar Voice - environment config
# Copy to .env and fill in what you have. EVERY value below is optional -
# the app must run with none of them set. See SETUP_KEYS.md for the fallback
# ladder (what happens when a key is missing or a call fails at runtime).

# --- LLM (Step 4 question tie-break, Step 9 wording + offline rule
# extraction) -----------------------------------------------------------
# Missing -> select.py falls back to rank-1 question, present.py falls back
# to name_short_hi/first-sentence wording, extract_rules.py cannot run at
# all (it's a one-time offline script, not part of a live call). No network
# call is attempted anywhere when this is unset.
# LLM_BASE_URL is only needed for an OpenAI-compatible endpoint that isn't
# OpenAI itself (e.g. Groq's https://api.groq.com/openai/v1) - leave blank
# to use OpenAI's own default.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=
LLM_TIMEOUT_MS=700

# --- Sarvam TTS/STT (Step 10) ----------------------------------------------
# Missing -> tts() prints text instead of speaking, stt() returns low
# confidence (routed to "unclear" -> buttons).
SARVAM_API_KEY=
SARVAM_TTS_LANG=hi-IN
SARVAM_STT_LANG=hi-IN

# --- Twilio (Step 11, not tonight) -----------------------------------------
# Missing -> use the terminal simulator (src/haqdaar/sim.py) instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- App ---------------------------------------------------------------
DB_PATH=haqdaar.db
SCHEME_SOURCE_JSON=optimized_schemes.json
QUESTION_BANK_PATH=question_bank.yaml
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
