# Haqdaar Voice - environment config
# Copy to .env and fill in what you have. EVERY value below is optional -
# the app must run with none of them set. See SETUP_KEYS.md for the fallback
# ladder (what happens when a key is missing or a call fails at runtime).

# --- LLM (Step 4 question tie-break, Step 9 wording + offline rule
# extraction) -----------------------------------------------------------
# Missing -> select.py falls back to rank-1 question, present.py falls back
# to name_short_hi/first-sentence wording, extract_rules.py cannot run at
# all (it's a one-time offline script, not part of a live call). No network
# call is attempted anywhere when this is unset.
# LLM_BASE_URL is only needed for an OpenAI-compatible endpoint that isn't
# OpenAI itself (e.g. Groq's https://api.groq.com/openai/v1) - leave blank
# to use OpenAI's own default.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=
LLM_TIMEOUT_MS=700

# --- Sarvam TTS/STT --------------------------------------------------------
# Missing -> tts() prints text instead of speaking, stt() returns low
# confidence (routed to "unclear" -> buttons). Same key covers TTS
# (bulbul:v3), STT (saaras:v3) and translation (mayura:v1).
SARVAM_API_KEY=
SARVAM_TTS_LANG=hi-IN
# "unknown" = auto-detect per utterance. Callers mix Hindi and English in
# one sentence, so pinning a language is worse than detecting it.
SARVAM_STT_LANG=unknown
# "translit" = Roman script out. Everything downstream matches Roman text
# (scheme names, DTMF labels, bank prompts), so Devanagari would fail
# every string comparison in engine.py. See voice.stt()'s docstring.
SARVAM_STT_MODE=translit

# --- Latency budgets -------------------------------------------------------
# Twilio hangs up if a webhook doesn't answer within 15 SECONDS, and one
# turn can spend time on all of: fetching the recording, Sarvam STT, an
# LLM call, then TTS. These caps keep the total well under that; each
# stage falls back to something deterministic when its budget is spent.
# Run `python -m scripts.warm_cache` so TTS is a cache hit and costs ~0 -
# synthesizing a long prompt live takes 4-6s (measured).
LLM_TIMEOUT_MS=3000
PRESENT_BUDGET_MS=4000          # total LLM time on the results turn
TTS_BUDGET_MS=5000              # total TTS time per turn
TTS_TIMEOUT_MS=4000             # one Sarvam TTS call
STT_TIMEOUT_MS=6000             # one Sarvam STT call
RECORDING_FETCH_TIMEOUT_MS=5000 # downloading the caller's audio from Twilio
RECORD_MAX_SECONDS=12           # cap on one recorded caller utterance

# --- Twilio (Step 11, not tonight) -----------------------------------------
# Missing -> use the terminal simulator (src/haqdaar/sim.py) instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- App ---------------------------------------------------------------
DB_PATH=haqdaar.db
SCHEME_SOURCE_JSON=optimized_schemes.json
QUESTION_BANK_PATH=question_bank.yaml
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
