%% Haqdaar - the whole system, laid out for a landscape slide.
%%
%% Reads LEFT TO RIGHT, in two lanes. The one number that shapes every
%% decision: Twilio drops the call if a webhook takes longer than 15
%% seconds. So the top lane is everything slow, done once before the
%% phone ever rings; the bottom lane is the call itself. Anything that
%% could be moved out of the live lane was.
%%
%% Green = deterministic   Orange = a model   Blue = a gate on model output
flowchart LR

    subgraph OFFLINE["① BEFORE ANY CALL · once · no time limit"]
        direction LR
        T1[("100 schemes<br/>372 rules<br/>English text")]
        T2["Sarvam mayura:v1<br/>TRANSLATE to Hindi"]
        T3{{"Every rupee figure<br/>survived?<br/>no → keep English"}}
        T4[("Hindi benefit lines<br/>97 of 100")]
        T5["Sarvam bulbul:v3<br/>RENDER 156 lines"]
        T6[("Audio cached<br/>on disk")]
        T1 --> T2 --> T3 --> T4
        T1 --> T5 --> T6
    end

    subgraph LIVE["② DURING THE CALL · every turn answers inside 15s"]
        direction LR
        A([Caller speaks<br/>Hindi]) --> B["Twilio records<br/>5s silence ends it"]
        B --> C["Sarvam saaras:v3<br/>speech → Roman text<br/>no translation needed"]
        C --> D{"Knows a<br/>scheme name?"}

        D -->|"press 1"| E["LLM picks from a<br/>token-overlap shortlist"]
        E --> F{{"A shortlisted scheme,<br/>or NONE"}}
        F --> G["Read the name<br/>back to confirm"]

        D -->|"press 2"| H["LLM maps sentence<br/>to attribute values"]
        H --> I{{"Only vocabulary the<br/>question bank declares"}}

        G --> J["narrow · SQL<br/>unknown never<br/>eliminates"]
        I --> J
        J --> K{"Narrow enough,<br/>or 6 questions?"}

        K -->|no| L["select · the question<br/>that cuts the most"]
        K -->|yes| M["present · English name<br/>+ Hindi benefit"]
        M --> N{{"Text we already<br/>hold, word for word"}}

        L --> O["Play cached audio"]
        N --> O
        O --> A
    end

    T4 -. "read here, never<br/>translated mid-call" .-> M
    T6 -. "played here, almost<br/>never synthesised" .-> O

    classDef fixed fill:#E4EFE9,stroke:#1B6B4A,stroke-width:1.5px,color:#123D2B
    classDef model fill:#F6E9E0,stroke:#A8552A,stroke-width:1.5px,color:#6B3418
    classDef gate  fill:#E2E9F3,stroke:#2C4C7C,stroke-width:1.5px,color:#1B3050
    classDef store fill:#EFF2EF,stroke:#5C6863,stroke-width:1.5px,color:#131B18
    classDef lane  fill:none,stroke:#B9C2BD,stroke-width:1px,color:#5C6863

    class A store
    class T1,T4,T6 store
    class T2,T5,C,E,H model
    class B,G,J,L,M,O fixed
    class T3,F,I,N gate
    class OFFLINE,LIVE lane
